# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ==========================================
# Frontend (Next.js & Node.js)
# ==========================================
node_modules/
frontend/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build & Output
.next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/
.vercel
frontend/.vercel

# Logs de Pacotes
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts
frontend/next-env.d.ts

# Cobertura de Testes
coverage/
frontend/coverage/

# ==========================================
# Backend (Python & FastAPI)
# ==========================================
# Ambientes Virtuais
.venv/
backend/.venv/
env/
venv/
ENV/

# Byte-code & Cache do Python
__pycache__/
backend/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
backend/.pytest_cache/

# ==========================================
# Variáveis de Ambiente e Segredos
# ==========================================
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Chaves e Certificados
*.pem
*.key
*.cert

# ==========================================
# Arquivos Temporários de Mídia / Storage Local
# ==========================================
# Caso salve uploads locais temporários
uploads/
backend/uploads/
temp/
backend/temp/

# ==========================================
# Sistema Operacional e IDES (VS Code, OS X)
# ==========================================
.DS_Store
*.pem
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.swp
*.swo